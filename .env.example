# ---- Vaani AI (app.vaanivoice.ai) ---------------------------------------
# Any long random string. Vaani AI webhooks are unsigned, so it goes in the URL:
# https://<app>.vercel.app/api/vaani/webhook?token=<VAANI_WEBHOOK_SECRET>
VAANI_WEBHOOK_SECRET=
# What Vaani charges per minute, used for the cost line on the dashboard
VAANI_RATE_INR_PER_MIN=5

# ---- Gemini Flash (classification + handoff note) -----------------------
# aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# INR per 1M tokens, for the cost line (check current Google pricing)
GEMINI_INR_PER_M_INPUT=0
GEMINI_INR_PER_M_OUTPUT=0

# ---- Supabase (call log) ------------------------------------------------
SUPABASE_URL=
# Project Settings → API keys → service_role / secret key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email handoff (Resend) ---------------------------------------------
# resend.com → API Keys → Create (Sending access)
RESEND_API_KEY=
# Must be on a domain you've verified in Resend. Until then use onboarding@resend.dev,
# which can only send to the email you signed up to Resend with.
EMAIL_FROM=Aangan Leads <onboarding@resend.dev>
# Where complaints and unassigned leads go
FRONT_DESK_EMAIL=
# Public URL of this app, used in the Claim / Reschedule links
APP_URL=
# Any long random string; signs the Claim / Reschedule links
LINK_SECRET=

# ---- HubSpot (qualified calls become deals) -----------------------------
# Settings → Integrations → Private apps. Scopes: crm.objects.contacts.write,
# crm.objects.deals.write, crm.objects.contacts.read, crm.objects.deals.read
HUBSPOT_PRIVATE_APP_TOKEN=

# ---- Booking ------------------------------------------------------------
# Fallback link if the caller didn't pick a slot on the call
CALCOM_BOOKING_URL=

# ---- Dashboard ----------------------------------------------------------
# Basic-auth password for Nikhil's dashboard (user name: aangan)
DASHBOARD_PASSWORD=
